# syntax=mirror.gcr.io/docker/dockerfile:1.24
# vim: ft=dockerfile
#
# Plain (non-Jinja2-templated) Dockerfile, unlike the Player's images
# under this directory. The Player's Dockerfiles are templated because
# they vary by board/architecture (Qt5 vs Qt6, armhf cross-compile,
# HW-decode ffmpeg pins, ...) via tools.image_builder; the Fleet Server
# is an ordinary, architecture-independent web service with none of
# that variance, so a plain Dockerfile + `docker compose build` is the
# smaller-diff choice for this phase. Revisit if it ever needs the
# image_builder pipeline's other benefits (git-hash labels, SBOM, CI
# integration) badly enough to justify the extra indirection.

FROM mirror.gcr.io/library/python:3.13-slim-trixie

RUN apt-get update && \
    apt-get -y install --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /uvx /usr/local/bin/

WORKDIR /app
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-install-project --no-default-groups \
    --group fleet-server

ENV VIRTUAL_ENV="/app/.venv"
ENV PATH="${VIRTUAL_ENV}/bin:$PATH"

RUN mkdir -p /usr/src/app
COPY . /usr/src/app/
WORKDIR /usr/src/app

ENV DJANGO_SETTINGS_MODULE="anthias_fleet_server.django_project.settings"
ENV PYTHONPATH="/usr/src/app/src"

CMD ["bash", "bin/start_fleet_server.sh"]
